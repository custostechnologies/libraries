<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- <RepositoryUrl>https://github.com/stpaulsgrammar/spgswebtools_nuget_packages</RepositoryUrl> -->

	  <RootNamespace>spgsWebTools</RootNamespace>

    <!-- NuGet Metadata Settings -->
    <packageId>spgsWebTools.XrmHelpers</packageId>
    <Version>1.0.4</Version>
    <Authors>Matthew Thomas</Authors>
    <Company>St. Paul's Grammar School</Company>
    <Description>Custom helpers to interact with the Xrm SDK.</Description>
    <!-- <PackageLicenseExpression></PackageLicenseExpression> -->
    <PackageTags>utility;helper'tools</PackageTags>
    <SignAssembly>True</SignAssembly>
    <UserSecretsId>f52bc6f4-a83e-423b-a498-a1ceee6adb3b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.10" PrivateAssets="All" />
  </ItemGroup>

</Project>
