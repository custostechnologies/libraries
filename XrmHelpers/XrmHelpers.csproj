<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Custos</RootNamespace>
    <packageId>Custos.XrmHelpers</packageId>
    <Version>1.0.6</Version>
    <Authors>Matthew Thomas</Authors>
    <Company>Custos Technologies</Company>
    <Description>Custom helpers to interact with the Xrm SDK.</Description>
    <PackageTags>utility;helper'tools</PackageTags>
    <SignAssembly>true</SignAssembly>
    <UserSecretsId>f52bc6f4-a83e-423b-a498-a1ceee6adb3b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Bcl.Cryptography" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client"
      PrivateAssets="All" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies"
      PrivateAssets="All" />
    <PackageReference Include="PolySharp">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="Microsoft.Identity.Client" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="**\Archive\**" />
    <Compile Remove="Test\**" />
  </ItemGroup>

</Project>
